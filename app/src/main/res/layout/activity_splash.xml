<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:background="#050B1E">
    <ImageView
        android:layout_width="150dp" android:layout_height="150dp"
        android:background="@drawable/ic_bg_round"
        android:src="@drawable/ic_fg" />
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="MT Browser"
        android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="Fast  •  Safe  •  Smart"
        android:textColor="#2E8BFF" android:textSize="14sp" android:textStyle="italic" />
</LinearLayout>
